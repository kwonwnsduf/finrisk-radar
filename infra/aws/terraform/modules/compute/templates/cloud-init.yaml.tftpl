#cloud-config
package_update: true
packages:
  - docker

write_files:
  - path: /opt/finrisk/docker-compose.aws.yml
    permissions: "0644"
    encoding: b64
    content: ${compose_b64}
  - path: /opt/finrisk/nginx.conf
    permissions: "0644"
    encoding: b64
    content: ${nginx_b64}
  - path: /opt/finrisk/deploy.sh
    permissions: "0700"
    encoding: b64
    content: ${deploy_script_b64}
  - path: /opt/finrisk/cloudwatch-agent.json
    permissions: "0644"
    encoding: b64
    content: ${cloudwatch_agent_b64}
  - path: /etc/systemd/system/finrisk-deploy.service
    permissions: "0644"
    content: |
      [Unit]
      Description=FinRisk Radar Day 18 containers
      Wants=network-online.target
      After=network-online.target docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/finrisk/deploy.sh
      ExecStop=/usr/bin/docker compose --env-file /opt/finrisk/.env.prod -f /opt/finrisk/docker-compose.aws.yml down
      TimeoutStartSec=900

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable --now docker
  - mkdir -p /usr/local/lib/docker/cli-plugins
  - curl -fsSL "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-linux-x86_64" -o /usr/local/lib/docker/cli-plugins/docker-compose
  - chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
  - test -f /swapfile || fallocate -l 2G /swapfile
  - chmod 0600 /swapfile
  - file /swapfile | grep -q 'swap file' || mkswap /swapfile
  - swapon /swapfile
  - grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - sysctl -w vm.swappiness=10
  - echo 'vm.swappiness=10' > /etc/sysctl.d/99-finrisk.conf
  - curl -fsSL "https://amazoncloudwatch-agent.s3.amazonaws.com/amazon_linux/amd64/latest/amazon-cloudwatch-agent.rpm" -o /tmp/amazon-cloudwatch-agent.rpm
  - rpm -U /tmp/amazon-cloudwatch-agent.rpm
  - /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/finrisk/cloudwatch-agent.json
  - systemctl daemon-reload
  - systemctl enable --now finrisk-deploy.service
