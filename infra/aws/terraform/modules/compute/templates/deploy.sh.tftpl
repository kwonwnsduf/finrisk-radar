#!/usr/bin/env bash
set -Eeuo pipefail
exec > >(tee -a /var/log/finrisk-deploy.log) 2>&1

cd /opt/finrisk

TOKEN=$(curl -fsS -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 300" http://169.254.169.254/latest/api/token)
INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
PUBLIC_IP=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)

get_secret() {
  local parameter_name="$1"
  local secret_value

  secret_value=$(aws ssm get-parameter \
    --region '${aws_region}' \
    --name "$parameter_name" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text)

  if [[ -z "$secret_value" || "$secret_value" == "None" ]]; then
    echo "Required SSM parameter is empty: $parameter_name" >&2
    return 1
  fi

  printf '%s' "$secret_value"
}

POSTGRES_PASSWORD=$(get_secret '${parameter_db}')
REDIS_PASSWORD=$(get_secret '${parameter_redis}')
JWT_SECRET=$(get_secret '${parameter_jwt}')
GOOGLE_CLIENT_SECRET=$(get_secret '${parameter_google}')
TOSS_SECRET_KEY=$(get_secret '${parameter_toss}')
DART_API_KEY=$(get_secret '${parameter_dart}')
NAVER_CLIENT_SECRET=$(get_secret '${parameter_naver}')
OPENAI_API_KEY=$(get_secret '${parameter_openai}')

umask 077
cat > .env.prod <<EOF
INSTANCE_ID=$INSTANCE_ID
SPRING_DATASOURCE_URL=jdbc:postgresql://${db_address}:5432/${db_name}
POSTGRES_USER=${db_username}
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
REDIS_PASSWORD=$REDIS_PASSWORD
JWT_SECRET=$JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d
GOOGLE_CLIENT_ID=${google_client_id}
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
OAUTH_FRONTEND_REDIRECT_URI=http://$PUBLIC_IP/login
OAUTH_CODE_TTL=180s
PAYMENT_ENABLED=true
PAYMENT_FRONTEND_BASE_URL=http://$PUBLIC_IP
TOSS_SECRET_KEY=$TOSS_SECRET_KEY
TOSS_WIDGET_CLIENT_KEY=${toss_widget_client_key}
AWS_REGION=${aws_region}
AWS_S3_BUCKET=${application_bucket_name}
DART_API_KEY=$DART_API_KEY
NAVER_NEWS_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_CLIENT_ID=${naver_client_id}
NAVER_CLIENT_SECRET=$NAVER_CLIENT_SECRET
DOCUMENT_COLLECTION_SCHEDULER_ENABLED=false
OPENAI_API_KEY=$OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=32
OPENAI_LLM_MODEL=${openai_llm_model}
EOF
chmod 0600 .env.prod

aws ecr get-login-password --region '${aws_region}' | \
  docker login --username AWS --password-stdin '${ecr_registry}'

docker compose --env-file .env.prod -f docker-compose.aws.yml config --quiet
docker compose --env-file .env.prod -f docker-compose.aws.yml pull
docker compose --env-file .env.prod -f docker-compose.aws.yml up -d --remove-orphans
