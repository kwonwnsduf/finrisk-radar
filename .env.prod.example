# Public entry point
NGINX_PORT=80

# PostgreSQL
POSTGRES_DB=finrisk
POSTGRES_USER=finrisk
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password

# Backend runtime
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
JWT_SECRET=replace-with-base64-encoded-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d

# Google OAuth2
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
OAUTH_FRONTEND_REDIRECT_URI=http://localhost/login
OAUTH_CODE_TTL=180s

# Frontend build-time public values.
# Keep both base URLs empty so browser requests use /api/** and /oauth2/**.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_OAUTH_BASE_URL=
TOSS_WIDGET_CLIENT_KEY=

# Payments are disabled until valid credentials are supplied.
PAYMENT_ENABLED=false
PAYMENT_FRONTEND_BASE_URL=http://localhost
TOSS_WIDGET_SECRET_KEY=

# Optional AWS S3 application integration
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=

# Optional external data providers
DART_API_KEY=
NAVER_NEWS_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DOCUMENT_COLLECTION_SCHEDULER_ENABLED=false
DOCUMENT_COLLECTION_SCHEDULER_CRON=0 0 * * * *
DOCUMENT_RECALCULATION_MAX_ATTEMPTS=5

# Optional OpenAI integration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=32
OPENAI_LLM_MODEL=
OPENAI_LLM_CONNECT_TIMEOUT=5s
OPENAI_LLM_READ_TIMEOUT=60s
OPENAI_LLM_MAX_OUTPUT_TOKENS=2000
OPENAI_LLM_MAX_CONTEXT_CHARACTERS=24000

# Loopback-only observability ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
